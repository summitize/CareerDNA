GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Create OAuth credentials at https://console.cloud.google.com/
# APIs & Services > Credentials > Create OAuth client ID > Web application
# Authorized JavaScript origins: http://localhost:3456
# Authorized redirect URIs: not required for Google Identity Services button flow

# Use the service-role key only in this server-side file. Never expose it in browser code.
